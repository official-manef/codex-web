# Copy to .env.local; keep credentials out of Git. All integrations stay optional.
# Exact consumers, activation status and deployment scope: docs/environment.md.

# Browser-visible Convex URL. Empty preserves the unlinked demo.
# Run `bun run convex:dev`; use the URL from your own deployment.
PUBLIC_CONVEX_URL=

# Browser-visible metadata. HTTPS origin only, no path; empty keeps noindex.
# Indexing requires explicit opt-in AND an indexable route. Keep previews false.
PUBLIC_SITE_URL=
PUBLIC_SEO_INDEXABLE=false
# Optional. Force the surface when the URL cannot tell: 'local' or 'cloud'. Anything else is
# ignored, so leaving it empty is safe. Local is detected automatically for loopback, private
# IPv4/IPv6, .local and *.ts.net hosts; everything else counts as a hosted build.
PUBLIC_SURFACE=
# Optional verification content values (not full meta tags or API secrets).
PUBLIC_GOOGLE_SITE_VERIFICATION=
PUBLIC_BING_SITE_VERIFICATION=
# Optional account handle, for example @youraccount.
PUBLIC_TWITTER_SITE=

# Implemented server transport adapters; no public feature is activated by flags.
# Configure the runtime executing the adapter: Convex OR SvelteKit server.
PAYMENTS_ENABLED=false
PAYMENT_PROVIDER=doku
DOKU_ENVIRONMENT=sandbox
DOKU_CLIENT_ID=
DOKU_SECRET_KEY=
EMAIL_ENABLED=false
EMAIL_PROVIDER=resend
RESEND_API_KEY=
EMAIL_FROM=

# Optional Google OIDC login and owner-scoped Convex notes. See docs/auth.md.
# PUBLIC_SITE_URL must match this app; register /auth/callback with Google.
AUTH_ENABLED=false
AUTH_PROVIDER=google
AUTH_CLIENT_ID=
AUTH_CLIENT_SECRET=
# Generate 32 random bytes as base64url; never reuse across products/environments.
AUTH_SESSION_SECRET=

# Optional BYOK assistant. Keys are entered per user, never server fallback keys.
# Select currently available model IDs explicitly, e.g. {"openai":["your-model-id"]}.
AI_ENABLED=false
AI_MODELS_JSON=
# Access requires Google sign-in OR this private operator token (at least 32 chars).
# Share only with trusted operators; each application should use a unique value.
CAPABILITY_ACCESS_TOKEN=

# Optional remote MCP client: configured HTTPS aliases + exact direct-tool allowlists.
# Example shape: [{"alias":"work","url":"https://your-mcp.example/mcp","auth":"bearer","tools":["read_status"]}]
# Composio uses its returned session URL and x-api-key header. See docs/ai-mcp.md.
MCP_CLIENT_ENABLED=false
MCP_SERVERS_JSON=
# Optional read-only template MCP endpoint /api/mcp/server; separate client token.
MCP_SERVER_ENABLED=false
MCP_SERVER_TOKEN=

# Optional read-only git surface (/api/git): status + recent commits for allowlisted roots.
# Roots are ':'-separated absolute paths, at most 8. Writes need GIT_POLICY_JSON below.
GIT_SURFACE_ENABLED=false
GIT_SURFACE_ROOTS=
# Per-verb git decisions. Empty or malformed denies every write.
# Example: {"git_diff":"allow","git_stage":"allow","git_commit":"ask","git_worktree":"deny"}
GIT_POLICY_JSON=

# Optional model tool use. Three things must agree: this flag, the request's toolUse field,
# and the per-verb policy. Empty or malformed AI_POLICY_JSON denies every verb.
AI_TOOLS_ENABLED=false
# Example: {"read_file":"allow","write_file":"deny","apply_patch":"deny","exec":"deny","mcp_app":"deny"}
AI_POLICY_JSON=

# Build target: vercel (default) or node. Set in shell/host BUILD settings, not this file.
# Docker selects node automatically.
# DEPLOY_TARGET=node
# Node runtime: explicit trusted origin. Keep aligned with PUBLIC_SITE_URL.
# ORIGIN=https://your-app.example
# PORT=3000
# adapter-node's request body cap; it defaults to 512K and rejects with 413 before any route
# runs. The app's own cap for /api/ai/chat is 11446960 bytes (two 4 MB images, base64), so a
# Node or Docker deployment must raise this or image chat breaks. Dockerfile sets it already.
# BODY_SIZE_LIMIT=11446960

# RECIPE ONLY: select a Google Cloud service and implement access first.
GCP_ENABLED=false
GCP_PROJECT_ID=
GCP_LOCATION=
GCP_STORAGE_BUCKET=
# Optional LOCAL ADC configuration-file path; not JSON contents or a cloud secret.
# Usually omit this and use `gcloud auth application-default login` locally.
# Never set this on Cloud Run when using an attached service identity.
# GOOGLE_APPLICATION_CREDENTIALS=

# RECIPE ONLY: scoped infrastructure API access after selecting a Cloudflare service.
# Account/zone identifiers are not secrets; API token is private and least-privilege.
# DNS/proxy use alone needs no token in the application runtime.
CLOUDFLARE_ENABLED=false
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_ZONE_ID=
CLOUDFLARE_API_TOKEN=

# Convex CLI writes CONVEX_DEPLOYMENT to .env.local when linking locally.
# Never commit .env.local or copy a production deploy key into it.
# CONVEX_DEPLOY_KEY belongs in the hosting provider's secret environment:
# production key for Production only, preview key for Preview only.
# Backend secrets belong on the Convex deployment (`bunx convex env set`).

# ── BYOK / cloud mode (all optional; the workspace runs local-only without them) ────────
# PUBLIC_CONVEX_URL is declared once, near the top of this file.
# AES-256-GCM master key for stored provider keys, base64 of 32 bytes:
#   openssl rand -base64 32
# This is a CONVEX deployment secret, not a frontend setting. Setting it here would ship the
# master key that decrypts every user's stored provider credentials to the web host, where
# `PUBLIC_*`-style leakage is one export away, and Convex would not read it anyway. Keep it
# commented out; set it on the deployment:
#   npx convex env set MODELS_ENC_KEY "$(openssl rand -base64 32)"
# MODELS_ENC_KEY=

# ── MANEF AI hub bridge (optional; the console runs without it) ─────────────────────────
# Loopback URL of `manef-ai/apps/hub`. Only 127.0.0.1, localhost or [::1] on http are
# accepted, and only three hub paths are forwarded. Unset = the MANEF AI screen reports
# "no hub configured" instead of guessing.
# MANEF_HUB_URL=http://127.0.0.1:3210

# ── Deployment identity ────────────────────────────────────────────────────────────────
# PUBLIC_SITE_URL is declared once, near the top of this file. Set the fork's production
# origin there; the empty default keeps previews unindexed.

# Optional bridge: the only way a tool call can reach the user's machine.
# Without both values, tool execution is refused instead of run in-process.
BRIDGE_URL=
BRIDGE_TOKEN=

# Optional dry run for scheduled tasks. Previews decisions; executes nothing.
AUTOMATIONS_ENABLED=false

# Optional sandboxed MCP app allowlist. Closed list: an app exists only if listed here.
MCP_APPS_ENABLED=false
# Example: [{"id":"weather","name":"Weather","origin":"https://apps.example","entry":"/w/index.html","surfaces":["panel"]}]
MCP_APPS_JSON=

# Sandboxed app allowlist gating. BOTH fences must pass: the mcp_app policy verb and this list.
# Empty allowlist means nothing runs. Malformed policy JSON denies.
MCP_APPS_ALLOW=
MCP_APPS_POLICY_JSON=

# Mirror local notes into Convex. Requires 'true' AND a signed-in user.
MEMORY_DUAL_WRITE=false

# Directories the bridge's /v1/fs verbs may touch. ':' separated, default: the bridge's cwd.
BRIDGE_FS_ROOTS=
