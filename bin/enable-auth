#!/usr/bin/env bash
# bin/enable-auth — turn on Google sign-in for one deployment, in one run.
#
# Sign-in needs four secrets this repository must never contain. This script reads them from
# the environment, validates their shape, then sets them where they belong: three on the
# SvelteKit host, two on the Convex deployment (Convex needs the client ID, never the secret).
#
#   AUTH_CLIENT_ID, AUTH_CLIENT_SECRET     from the Google OAuth web client
#   AUTH_SESSION_SECRET                    32 random bytes, base64url (generated if unset)
#   PUBLIC_CONVEX_URL                      the deployment the browser talks to
#
# Usage:
#   bin/enable-auth --dry-run                 # print what would be set, touch nothing
#   bin/enable-auth                           # local .env.local + `convex env set`
#   bin/enable-auth --vercel <project>        # also set them on a Vercel project (needs vercel CLI)
#
# Exit codes: 0 ok, 1 bad input, 2 missing tool. A failed write is a warning, not an exit: the
# script writes what it can and names the setting an operator must apply by hand.
set -uo pipefail

cd "$(dirname "$0")/.." || exit 2

DRY=0
VERCEL_PROJECT=""
while [ $# -gt 0 ]; do
	case "$1" in
		--dry-run) DRY=1 ;;
		--vercel)
			shift
			VERCEL_PROJECT="${1:-}"
			[ -n "$VERCEL_PROJECT" ] || { echo 'error: --vercel needs a project name' >&2; exit 1; }
			;;
		*) echo "error: unknown argument $1" >&2; exit 1 ;;
	esac
	shift
done

fail() { printf 'error: %s\n' "$1" >&2; exit "${2:-1}"; }

# ── inputs ────────────────────────────────────────────────────────────────────────────────

CLIENT_ID="${AUTH_CLIENT_ID:-}"
CLIENT_SECRET="${AUTH_CLIENT_SECRET:-}"
SESSION_SECRET="${AUTH_SESSION_SECRET:-}"
CONVEX_URL="${PUBLIC_CONVEX_URL:-}"
SITE_URL="${PUBLIC_SITE_URL:-}"

[ -n "$CLIENT_ID" ] || fail 'set AUTH_CLIENT_ID (Google OAuth web client ID)'
[ -n "$CLIENT_SECRET" ] || fail 'set AUTH_CLIENT_SECRET'
[ -n "$CONVEX_URL" ] || fail 'set PUBLIC_CONVEX_URL (https://<deployment>.convex.cloud)'
[ -n "$SITE_URL" ] || fail 'set PUBLIC_SITE_URL (the exact origin, no path)'

# A Google web client ID always ends this way. A wrong value here produces a confusing
# "invalid_client" at the callback, so it is refused up front.
case "$CLIENT_ID" in
	*.apps.googleusercontent.com) ;;
	*) fail 'AUTH_CLIENT_ID must end with .apps.googleusercontent.com' ;;
esac
case "$CONVEX_URL" in
	https://*) ;;
	*) fail 'PUBLIC_CONVEX_URL must be https://' ;;
esac
case "$SITE_URL" in
	https://*/*) fail 'PUBLIC_SITE_URL must not include a path' ;;
	https://*) ;;
	http://localhost*|http://127.0.0.1*) ;;
	*) fail 'PUBLIC_SITE_URL must be https (http is allowed only on loopback)' ;;
esac
[ "${#CLIENT_SECRET}" -ge 16 ] || fail 'AUTH_CLIENT_SECRET looks too short'

if [ -z "$SESSION_SECRET" ]; then
	command -v openssl >/dev/null || fail 'openssl is required to generate AUTH_SESSION_SECRET' 2
	SESSION_SECRET="$(openssl rand -base64 32 | tr '+/' '-_' | tr -d '=')"
	echo 'generated AUTH_SESSION_SECRET (32 bytes, base64url)'
fi
# The cookie is sealed with this key; jose needs exactly 32 bytes after base64url decoding.
DECODED_LEN="$(printf '%s' "$SESSION_SECRET" | node -e "
	let s='';process.stdin.on('data',c=>s+=c);process.stdin.on('end',()=>{
		const b=Buffer.from(s.trim(),'base64url');process.stdout.write(String(b.length));
	});")"
[ "$DECODED_LEN" = '32' ] || fail "AUTH_SESSION_SECRET must decode to 32 bytes, got $DECODED_LEN"

printf 'callback URL to register in Google: %s/auth/callback\n' "$SITE_URL"

# ── plan ──────────────────────────────────────────────────────────────────────────────────

printf '\nsettings to apply\n'
printf '  svelte host  AUTH_ENABLED=true, AUTH_PROVIDER=google, AUTH_CLIENT_ID, AUTH_CLIENT_SECRET, AUTH_SESSION_SECRET\n'
printf '  svelte host  PUBLIC_SITE_URL=%s, PUBLIC_CONVEX_URL=%s\n' "$SITE_URL" "$CONVEX_URL"
printf '  convex       AUTH_CLIENT_ID only (no secret, no session key)\n'
[ -n "$VERCEL_PROJECT" ] && printf '  vercel       project %s, production+preview\n' "$VERCEL_PROJECT"

if [ "$DRY" -eq 1 ]; then
	printf '\ndry run: nothing was written\n'
	exit 0
fi

# ── local env file ────────────────────────────────────────────────────────────────────────

ENV_FILE=.env.local
touch "$ENV_FILE"
chmod 600 "$ENV_FILE"
# Rewrite in place rather than appending duplicates: a second AUTH_CLIENT_ID line is a
# silent shadow depending on which loader wins.
set_local() {
	local key="$1" value="$2"
	if grep -q "^${key}=" "$ENV_FILE" 2>/dev/null; then
		KEY="$key" VALUE="$value" perl -i -pe 's/^\Q$ENV{KEY}\E=.*$/$ENV{KEY}."=".$ENV{VALUE}/e' "$ENV_FILE"
	else
		printf '%s=%s\n' "$key" "$value" >>"$ENV_FILE"
	fi
}
set_local AUTH_ENABLED true
set_local AUTH_PROVIDER google
set_local AUTH_CLIENT_ID "$CLIENT_ID"
set_local AUTH_CLIENT_SECRET "$CLIENT_SECRET"
set_local AUTH_SESSION_SECRET "$SESSION_SECRET"
set_local PUBLIC_SITE_URL "$SITE_URL"
set_local PUBLIC_CONVEX_URL "$CONVEX_URL"
printf '\nwrote %s (mode 600, git-ignored)\n' "$ENV_FILE"

# ── convex ────────────────────────────────────────────────────────────────────────────────

if ! command -v npx >/dev/null; then
	printf 'warning: npx not found; set AUTH_CLIENT_ID on the Convex deployment yourself:\n' >&2
	printf '         npx convex env set AUTH_CLIENT_ID %s\n' "$CLIENT_ID" >&2
else
	if npx --no-install convex env set AUTH_CLIENT_ID "$CLIENT_ID" >/dev/null 2>&1; then
		printf 'set AUTH_CLIENT_ID on the Convex deployment\n'
	else
		printf 'warning: could not set AUTH_CLIENT_ID on Convex (not logged in, or no deployment linked)\n' >&2
		printf '         run: npx convex env set AUTH_CLIENT_ID %s\n' "$CLIENT_ID" >&2
	fi
fi

# ── vercel ────────────────────────────────────────────────────────────────────────────────

if [ -n "$VERCEL_PROJECT" ]; then
	if ! command -v vercel >/dev/null; then
		printf 'warning: vercel CLI not installed; set these on the project yourself:\n' >&2
		printf '         AUTH_ENABLED, AUTH_PROVIDER, AUTH_CLIENT_ID, AUTH_CLIENT_SECRET,\n' >&2
		printf '         AUTH_SESSION_SECRET, PUBLIC_SITE_URL, PUBLIC_CONVEX_URL\n' >&2
	else
		# `vercel env add` reads the value from stdin and refuses a duplicate key.
		add_env() {
			local key="$1" value="$2"
			printf '%s' "$value" | vercel env add "$key" production --force >/dev/null 2>&1 ||
				printf 'warning: vercel env add %s failed\n' "$key" >&2
			printf '%s' "$value" | vercel env add "$key" preview --force >/dev/null 2>&1 ||
				true
		}
		add_env AUTH_ENABLED true
		add_env AUTH_PROVIDER google
		add_env AUTH_CLIENT_ID "$CLIENT_ID"
		add_env AUTH_CLIENT_SECRET "$CLIENT_SECRET"
		add_env AUTH_SESSION_SECRET "$SESSION_SECRET"
		add_env PUBLIC_SITE_URL "$SITE_URL"
		add_env PUBLIC_CONVEX_URL "$CONVEX_URL"
		printf 'pushed settings to Vercel project %s\n' "$VERCEL_PROJECT"
	fi
fi

printf '\nnext: deploy, then sign in at %s/auth/login\n' "$SITE_URL"
printf 'a fresh deployment with no AUTH_* still answers /auth/login with 404 — that is the check\n'
